# Sitenin yayındaki tam adresi (sonda / olmadan).
# canonical, sitemap.xml, robots.txt ve Open Graph adresleri buradan üretilir.
# Derleme anında gömülür — değiştirince yeniden derlemek gerekir.
NEXT_PUBLIC_SITE_URL=https://nazasyemek.bilnetyazilim.com

# --- Formlar (Hızlı Ön Hesaplama + Teklif) ---
# Site statik yayınlandığı için formlar tarayıcıdan doğrudan FormSubmit'e gider
# ve info@nazasyemek.com adresine mail olarak düşer. Tanımsızsa bu varsayılan kullanılır.
# İlk gönderimde FormSubmit o adrese bir onay maili yollar; bağlantıya bir kez
# tıklanana kadar mailler iletilmez. Onaydan sonra FormSubmit'in verdiği gizli
# takma adla (https://formsubmit.co/ajax/<rastgele-id>) değiştirmek adresi gizler.
NEXT_PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/info@nazasyemek.com
